# --- Base de données (obligatoire sur Vercel) ---
# Même PostgreSQL que le bot (Prisma). Variable à copier depuis votre hébergeur DB.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- Admin web (obligatoire en prod) ---
# Mot de passe unique pour la page /login (chaîne longue et aléatoire).
ADMIN_PANEL_SECRET="change-me-to-a-long-random-string"

# --- Discord (recommandé) ---
# Même token que le bot : liste des salons texte via l’API Discord (formulaires admin).
DISCORD_BOT_TOKEN=""

# --- Contrôle des runs (pause / reprise / arrêt / phase suivante) ---
# URL publique du service bot (ex. https://votre-bot.up.railway.app), sans slash final.
BOT_CONTROL_URL="https://your-bot-service.example.com"
# Même valeur que BOT_CONTROL_SECRET sur le bot (jamais exposée au navigateur : appels serveur uniquement).
BOT_CONTROL_SECRET=""

# Note : sur Vercel, définissez ces variables dans Project → Settings → Environment Variables.
# Ne préfixez pas les secrets avec NEXT_PUBLIC_ (ils ne doivent pas partir au client).

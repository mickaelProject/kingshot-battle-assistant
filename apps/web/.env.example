# =============================================================================
# App web (Next.js) — copiez vers apps/web/.env en local ou définissez sur Railway
# =============================================================================

# --- Base de données (OBLIGATOIRE en prod : Railway, Neon, etc.) ---
# Même URL que le bot. Sur Railway : le service WEB doit avoir sa propre copie
# de DATABASE_URL (référence ${{ Postgres.DATABASE_URL }} ou collage depuis Connect).
#
# Exemple Railway (hôte indicatif) — le code ajoute sslmode=require si absent :
# DATABASE_URL="postgresql://postgres:PASSWORD@containers-xxx.railway.app:5432/railway?schema=public"
#
# Si erreur SSL / timeout, ajoutez explicitement : &sslmode=require
# (ou ?schema=public&sslmode=require si pas de ? dans l’URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"

# --- Développement local ---
# apps/web/env.local.example → apps/web/.env.local (priorité sur ce fichier)
# Voir aussi : .env.railway.example à la racine du repo (checklist Railway)

# --- Admin web (obligatoire en prod) ---
ADMIN_PANEL_SECRET="change-me-to-a-long-random-string"

# --- Discord ---
# Token du bot (liste des salons dans l’admin)
DISCORD_BOT_TOKEN=""
# ID d’application Discord (OAuth « Inviter le bot »)
DISCORD_CLIENT_ID=""

# URL publique du site SANS slash final (Railway : https://xxx.up.railway.app)
NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"
# Redirection OAuth après autorisation (doit exister dans le portail Discord)
# DISCORD_INSTALL_REDIRECT_URL="https://your-app.up.railway.app/dashboard/server"

# --- Contrôle des runs (pause / reprise) ---
BOT_CONTROL_URL="https://your-bot-service.up.railway.app"
BOT_CONTROL_SECRET=""

# Note : ne préfixez pas les secrets avec NEXT_PUBLIC_

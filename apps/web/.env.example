# --- Base de données (obligatoire sur Vercel) ---
# Même PostgreSQL que le bot (Prisma). Variable à copier depuis votre hébergeur DB.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- Développement local (recommandé) ---
# Ne modifie pas ce fichier pour Railway : crée plutôt apps/web/.env.local
# (voir apps/web/env.local.example + docs/DEVELOPPEMENT-LOCAL.md).
# .env.local surcharge .env : PostgreSQL Docker → npm run db:up à la racine.

# --- Admin web (obligatoire en prod) ---
# Mot de passe unique pour la page /login (chaîne longue et aléatoire).
ADMIN_PANEL_SECRET="change-me-to-a-long-random-string"

# --- Discord (recommandé) ---
# Même token que le bot : liste des salons texte via l’API Discord (formulaires admin).
DISCORD_BOT_TOKEN=""
# ID d’application Discord (même valeur que DISCORD_CLIENT_ID du bot) — lien « Inviter le bot » dans l’admin.
DISCORD_CLIENT_ID=""
# Après « Autoriser » sur Discord, redirection vers cette URL (doit être identique à une entrée OAuth2 → Redirects).
# Ex. dev : http://localhost:3000/dashboard/server
# DISCORD_INSTALL_REDIRECT_URL="http://localhost:3000/dashboard/server"
# Sinon : URL publique du site sans slash final (on ajoute /dashboard/server).
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optionnel : bits de permissions OAuth (défaut = messages + embeds + salons).
# DISCORD_BOT_INVITE_PERMISSIONS="125952"

# --- Contrôle des runs (pause / reprise / arrêt / phase suivante) ---
# URL publique du service bot (ex. https://votre-bot.up.railway.app), sans slash final.
BOT_CONTROL_URL="https://your-bot-service.example.com"
# Même valeur que BOT_CONTROL_SECRET sur le bot (jamais exposée au navigateur : appels serveur uniquement).
BOT_CONTROL_SECRET=""

# Note : sur Vercel, définissez ces variables dans Project → Settings → Environment Variables.
# Ne préfixez pas les secrets avec NEXT_PUBLIC_ (ils ne doivent pas partir au client).

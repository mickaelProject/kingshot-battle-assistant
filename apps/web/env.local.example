# Copier vers apps/web/.env.local (non commité)
# Priorité sur apps/web/.env — idéal pour PostgreSQL local pendant que .env pointe vers Railway.

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/kingshot?schema=public"

# Garde les autres clés (ADMIN_PANEL_SECRET, etc.) dans apps/web/.env
# ou duplique-les ici si besoin.

# --- Discord + bot en local (invitation + liste des salons + contrôle des runs) ---
# Voir docs/DEVELOPPEMENT-LOCAL.md section « Discord en local ».
#
# URL du dashboard : sert aussi de base pour la redirection OAuth après « Inviter le bot ».
# À enregistrer EXACTEMENT dans le portail Discord → OAuth2 → Redirects :
#   http://localhost:3000/dashboard/server
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# (alternative) DISCORD_INSTALL_REDIRECT_URL="http://localhost:3000/dashboard/server"
#
# Même ID que sur le bot (portail Discord → application → ID d’application).
DISCORD_CLIENT_ID=""

# Optionnel (dev) : ID du serveur Discord — préremplit le formulaire « Enregistrer en base » sur Modèles / Serveur.
# DEV_DISCORD_GUILD_ID=""
#
# Même token que DISCORD_TOKEN du bot — nécessaire pour charger les salons dans l’admin.
DISCORD_BOT_TOKEN=""
#
# API HTTP du bot (pause / reprise des batailles). Même secret que BOT_CONTROL_SECRET du bot.
BOT_CONTROL_URL="http://127.0.0.1:3847"
BOT_CONTROL_SECRET="change-me-local-dev-only"

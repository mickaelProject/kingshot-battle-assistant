# Copier vers apps/bot/.env.local (non commité)
# Surcharge apps/bot/.env — même DATABASE_URL que le web en local.
#
# Port 5433 = Docker du repo (npm run db:up). Si tu utilises ton propre Postgres sur 5432,
# remplace par ton user / mot de passe / port réels (voir docs/DEVELOPPEMENT-LOCAL.md).

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/kingshot?schema=public"

# --- Discord (obligatoire pour tester le bot en local) ---
# Portail https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""
#
# Même valeur que BOT_CONTROL_SECRET dans apps/web/.env.local
BOT_CONTROL_SECRET="change-me-local-dev-only"
#
# Après avoir invité le bot sur ton serveur de test : clic droit sur le serveur → ID (mode dev Discord).
# Puis : npm run commands:register -w @kingshot/bot  (enregistre les slash instantanément sur cette guilde)
DISCORD_DEV_GUILD_ID=""

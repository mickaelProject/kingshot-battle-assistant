# =============================================================================
# Bot Discord — copiez vers apps/bot/.env en local ou variables Railway (service bot)
# =============================================================================

# --- Base de données (OBLIGATOIRE) ---
# Exactement la MÊME DATABASE_URL que sur le service Web Next.js.
# Railway : si seul Postgres a la variable, référencez-la sur le service bot :
#   ${{ Postgres.DATABASE_URL }}
#
# Avec SSL explicite (souvent requis hors réseau privé Railway) :
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"

# --- Développement local ---
# apps/bot/env.local.example → apps/bot/.env.local

# --- Discord (obligatoire) ---
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""

# --- API HTTP « run control » (même secret que BOT_CONTROL_SECRET côté web) ---
BOT_CONTROL_SECRET=""
BOT_CONTROL_PORT=3847

DISCORD_DEV_GUILD_ID=""
SEED_DISCORD_GUILD_ID=""

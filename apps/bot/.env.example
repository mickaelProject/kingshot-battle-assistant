# --- Base de données (obligatoire) ---
# Même URL que l’app web (Prisma). En prod : chaîne fournie par Railway / Supabase / Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- Discord (obligatoire) ---
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""

# --- API HTTP « run control » (recommandé en prod pour pause / reprise / arrêt depuis l’admin) ---
# Secret partagé avec l’app web (variable BOT_CONTROL_SECRET côté Vercel).
BOT_CONTROL_SECRET=""
# Port d’écoute explicite (dev local). En prod sur Railway/Render, la plateforme fournit souvent PORT :
# le bot utilise PORT si BOT_CONTROL_PORT est vide.
BOT_CONTROL_PORT=3847
# Optionnel : forcer l’interface (défaut prod = 0.0.0.0, dev = 127.0.0.1).
# BOT_CONTROL_HOST=0.0.0.0

# Optionnel : enregistrer les commandes slash uniquement dans cette guilde (instantané en dev).
DISCORD_DEV_GUILD_ID=""

# Optionnel : `npm run db:seed` — ID Discord du serveur pour le jeu de données d’exemple.
SEED_DISCORD_GUILD_ID=""

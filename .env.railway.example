# =============================================================================
# Railway — checklist variables (à copier dans l’UI Railway, PAS dans Git)
# =============================================================================
#
# Le service Web (Next.js) et le service Bot doivent TOUS DEUX avoir DATABASE_URL.
# Le plugin PostgreSQL crée la variable sur le service "Postgres" uniquement :
#   → Onglet du service Web → Variables → Add variable
#   → "Reference" vers Postgres : ${{ Postgres.DATABASE_URL }}
#      (remplacez "Postgres" par le nom exact de votre service DB)
#   → OU copiez la valeur depuis Postgres → Connect → "Public URL" ou "Private URL"
#
# Si la connexion échoue encore, ajoutez à la fin de l’URL (sans dupliquer ?) :
#   &sslmode=require
# ou si l’URL n’a aucun paramètre :
#   ?schema=public&sslmode=require
#
# Le code web normalise automatiquement sslmode pour les hôtes *.railway.app, etc.
#
# -----------------------------------------------------------------------------
# Service WEB (ex. kingshot-web-production)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://...   (identique au bot)
# NODE_ENV=production
# ADMIN_PANEL_SECRET=             (long secret aléatoire)
# DISCORD_BOT_TOKEN=              (même valeur que DISCORD_TOKEN du bot)
# DISCORD_CLIENT_ID=
# NEXT_PUBLIC_APP_URL=https://VOTRE-APP.up.railway.app
# BOT_CONTROL_URL=https://VOTRE-BOT.up.railway.app
# BOT_CONTROL_SECRET=             (même secret que sur le bot)
#
# -----------------------------------------------------------------------------
# Service BOT
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://...   (identique au web)
# DISCORD_TOKEN=
# DISCORD_CLIENT_ID=
# BOT_CONTROL_SECRET=
# PORT=                           (souvent injecté par Railway)
#
# =============================================================================
